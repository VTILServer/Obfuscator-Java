--[[
  %%_INFOWATERMARK%%
  Version: %%_Version%%
]]

local Byte = string["byte"]
local Sub = string["sub"]
local Char = string["char"]
local Concat = table["concat"]
local Select = select

local function bxor(a, b)
	local out = 0
	local place = 1
	while a > 0 or b > 0 do
		local aa = a % 2
		local bb = b % 2
		if aa ~= bb then
			out = out + place
		end
		a = (a - aa) / 2
		b = (b - bb) / 2
		place = place * 2
	end
	return out
end

if bit and bit["bxor"] then
	bxor = bit["bxor"]
end

local kdslksdsoipso = {nil, bxor}
local dsuydsdslkdsldkl = Char
local jsddshsuidsjkds = Concat

%%CUSTOMSTRINGTABLE%%

local function dddddddd(value, keyIndex)
	return dsuydsdslkdsldkl(kdslksdsoipso[2](abcdefg[keyIndex], value))
end

local function rot13_decipher(text)
	return (text:gsub("%a", function(ch)
		local base = ch:lower() == ch and Byte("a") or Byte("A")
		return Char(((Byte(ch) - base - 13) % 26) + base)
	end))
end

local function split(text, pattern)
	local parts = {}
	local startAt = 1
	while true do
		local left, right = text:find(pattern, startAt, true)
		if not left then
			parts[#parts + 1] = text:sub(startAt)
			break
		end
		parts[#parts + 1] = text:sub(startAt, left - 1)
		startAt = right + 1
	end
	return parts
end

local function gBit(value, startBit, endBit)
	if endBit then
		local width = endBit - startBit + 1
		local shifted = value / (2 ^ (startBit - 1))
		return shifted % (2 ^ width) - shifted % 1
	end
	local mask = 2 ^ (startBit - 1)
	return value % (mask + mask) >= mask and 1 or 0
end

local function decodeTextBytes(text)
	return (text:gsub("..", function(pair)
		local first = Byte(pair, 1, 1)
		local second = Byte(pair, 2, 2)
		if first == 69 and second == 83 then
			return Char(0)
		end
		if second == 33 then
			return Char(tonumber(pair:sub(1, 1), 16))
		end
		if first == 71 then
			return Char(0)
		end
		return Char(tonumber(pair, 16))
	end))
end

local function unwrapBytecode(raw)
    local key = ((%%BYTECODE_KEY_A%% * %%BYTECODE_KEY_B%% + %%BYTECODE_KEY_C%%) % 255) + 1
    local salt = (%%BYTECODE_SALT_A%% * %%BYTECODE_SALT_B%% + %%BYTECODE_SALT_C%%) % 256
    local function nextBytecodeState(state)
        return (state * %%BYTECODE_LCG_MULTIPLIER%% + %%BYTECODE_LCG_INCREMENT%%) % 65536
    end
    local function bytecodeMask(state, index)
        return (math.floor(state / 257) + state + salt + index * 73 + (index % 19) * 41) % 256
    end
    local state = (key * 257 + salt * 17) % 65536
    for i = 0, 3 do
        state = (state + Byte(raw, 1 + i, 1 + i) * (i * 29 + 13)) % 65536
    end
    local length = 0
    local scale = 1
    for i = 0, 3 do
        state = nextBytecodeState(state)
        local encodedLength = Byte(raw, 5 + i, 5 + i)
        length = length + bxor(encodedLength, bytecodeMask(state, i)) * scale
        scale = scale * 256
    end
    local expectedChecksum = 0
    scale = 1
    for i = 0, 3 do
        state = nextBytecodeState(state)
        local encodedChecksum = Byte(raw, 9 + i, 9 + i)
        expectedChecksum = expectedChecksum + bxor(encodedChecksum, bytecodeMask(state, i + 4)) * scale
        scale = scale * 256
    end
    local decoded = {}
    local checksum = 0
    for i = 0, length - 1 do
        state = nextBytecodeState(state)
        local mask = bytecodeMask(state, i + 8)
        local encoded = Byte(raw, 13 + i, 13 + i)
        local mixed = (encoded - ((mask + i + salt) % 256)) % 256
        local byte = bxor(mixed, mask)
        checksum = (checksum + byte * (length - i)) % 2147483648
        decoded[length - i] = Char(byte)
    end
    if checksum ~= expectedChecksum then
        error(%%STRING14%%, 0)
    end
    return Concat(decoded)
end

local __xell_chunk_instr = 1
local __xell_chunk_const = 2
local __xell_chunk_proto = 3
local __xell_chunk_lines = 4
local __xell_chunk_name = 5
local __xell_chunk_first_line = 6
local __xell_chunk_last_line = 7
local __xell_chunk_upvals = 8
local __xell_chunk_args = 9
local __xell_chunk_vargs = 10
local __xell_chunk_stack = 11
local __xell_inst_data = 4
local __xell_inst_opcode = 5

local function DecodeChunk(text)
	local ByteString = unwrapBytecode(decodeTextBytes(text))
	local Pos = 1
	local gInt
	local gSizet

	local function gBits8()
		local value = Byte(ByteString, Pos, Pos)
		Pos = Pos + 1
		return value
	end

	local function gBits32()
		local a, b, c, d = Byte(ByteString, Pos, Pos + 3)
		Pos = Pos + 4
		return d * 16777216 + c * 65536 + b * 256 + a
	end

	local function gBits64()
		return gBits32() * 4294967296 + gBits32()
	end

	local function gFloat()
		local left = gBits32()
		local right = gBits32()
		local mantissa = gBit(right, 1, 20) * 2 ^ 32 + left
		local exponent = gBit(right, 21, 31)
		local sign = (-1) ^ gBit(right, 32)
		local normal = 1
		if exponent == 0 then
			if mantissa == 0 then
				return sign * 0
			end
			exponent = 1
			normal = 0
		elseif exponent == 2047 then
			return mantissa == 0 and sign * (1 / 0) or sign * (0 / 0)
		end
		return math.ldexp(sign, exponent - 1023) * (normal + mantissa / 2 ^ 52)
	end

	local function gString(length, deob)
		if not length then
			length = gSizet()
			if length == 0 then
				return
			end
		end
		local value = Sub(ByteString, Pos, Pos + length - 1)
		Pos = Pos + length
		return deob and rot13_decipher(value) or value
	end

	%%OPCODES%%

	local function ChunkDecode()
		local Instr = {}
		local Const = {}
		local Proto = {}
		local Chunk = {
			[__xell_chunk_instr] = Instr,
			[__xell_chunk_const] = Const,
			[__xell_chunk_proto] = Proto,
			[__xell_chunk_lines] = {},
			%%CHUNKRANDOM%%
		}

		if Chunk[__xell_chunk_name] then
			Chunk[__xell_chunk_name] = Sub(Chunk[__xell_chunk_name], 1, -2)
		end

		for Idx = 1, gInt() do
			local Data = gBits32()
			local Opco = gBit(Data, 1, 6)
			local Type = Opcode[Opco]
			local Inst = {
				gBit(Data, 7, 14),
				[__xell_inst_data] = Data,
				[__xell_inst_opcode] = Opco
			}
			%%CODES%%
			Instr[Idx] = Inst
		end

		if gFloat() == 1 then
			for _ = 1, 5 do
				gBits8()
				gString(nil, false)
			end
		end

		for Idx = 1, gInt() - 3 do
			local Type = gBits8()
			local Cons
			if Type == 1 then
				Cons = gBits8() == 0
			elseif Type == 3 then
				Cons = gFloat()
			elseif Type == 4 then
				local encoded = Sub(gString(nil, false), 1, -2)
				local parts = split(encoded, "|XELL|")
				Cons = rot13_decipher(parts[1] .. parts[2])
			end
			Const[Idx - 1] = Cons
		end

		for Idx = 1, gInt() do
			Proto[Idx - 1] = ChunkDecode()
		end

		for Idx = 1, gInt() do
			Chunk[__xell_chunk_lines][Idx] = gBits32()
		end
		for _ = 1, gInt() do
			gString()
			gBits32()
			gBits32()
		end
		for _ = 1, gInt() do
			gString()
		end

		return Chunk
	end

	gInt = gBits32
	gSizet = gBits32
	return ChunkDecode()
end

local function collectReturns(...)
	return Select(%%STRING4%%, ...), {...}
end

local function XellRun(Chunk, Env, Upvalues)
	local Instr = Chunk[__xell_chunk_instr]
	local Const = Chunk[__xell_chunk_const]
	local Proto = Chunk[__xell_chunk_proto]

	local function raiseRuntime(err, position)
		local name = Chunk[__xell_chunk_name] or %%STRING7%%
		local line = Chunk[__xell_chunk_lines][position] or %%STRING5%%
		error(string["format"](%%STRING6%%, name, line, tostring(err)), 0)
	end

	return function(...)
		local InstrPoint = 1
		local Top = -1
		local Vararg = {}
		local Varargsz = Select(%%STRING4%%, ...) - 1
		local GStack = {}
		local Lupvals = {}
		local Stack = setmetatable({}, {
			__index = GStack,
			__newindex = function(_, key, value)
				if key > Top then
					Top = key
				end
				GStack[key] = value
			end
		})

		local Inst, %%ENUMVARIABLE%%
		local _Returns = collectReturns
		%%VMHANDLERS%%

		local function run()
			while true do
				Inst = Instr[InstrPoint]
				%%ENUMVARIABLE%% = Inst[__xell_inst_opcode]
				InstrPoint = InstrPoint + 1
				%%VMINSTRUCTIONS%%
			end
		end

		local Args = {...}
		for Idx = 0, Varargsz do
			if Idx >= Chunk[__xell_chunk_args] then
				Vararg[Idx - Chunk[__xell_chunk_args]] = Args[Idx + 1]
			else
				Stack[Idx] = Args[Idx + 1]
			end
		end

		local ok, values, count = pcall(run)
		if ok then
			if values and count and count > 0 then
				return unpack(values, 1, count)
			end
			return
		end
		raiseRuntime(values, InstrPoint - 1)
	end
end

local bytetbl = {}
%%BYTECODE_CHUNKS%%

local byteorderData = {%%BYTECODE_ORDER_DATA%%}

local function decodeBytecodeChunk(entry)
	local state = entry[1]
	local bytes = {}
	for i = 2, #entry do
		state = (state * %%BYTECODE_CHUNK_MULTIPLIER%% + %%BYTECODE_CHUNK_INCREMENT%%) % 256
		bytes[i - 1] = Char((entry[i] - state - i) % 256)
	end
	return Concat(bytes)
end

local function decodeBytecodeOrder()
	local state = %%BYTECODE_ORDER_SEED%%
	local order = {}
	for i = 1, #byteorderData do
		state = (state * %%BYTECODE_ORDER_MULTIPLIER%% + %%BYTECODE_ORDER_INCREMENT%%) % 256
		order[i] = byteorderData[i] - state - i
	end
	return order
end

local function getBytecodeText()
	local parts = {}
	local byteorder = decodeBytecodeOrder()
	for i = 1, #byteorder do
		parts[i] = decodeBytecodeChunk(bytetbl[byteorder[i]])
	end
	return Concat(parts)
end

return XellRun(DecodeChunk(getBytecodeText()), getfenv())()
